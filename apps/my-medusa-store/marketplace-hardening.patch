+import { createStep, StepResponse } from "@medusajs/framework/workflows-sdk";
+import { ContainerRegistrationKeys } from "@medusajs/framework/utils";
+
+type Input = {
+  vendor_admin_id: string;
+  product_id: string;
+  variant_ids?: string[];
+};
+
+type Output = {
+  vendor_id: string;
+  product_id: string;
+  product_variant_ids: string[];
+};
+
+/**
+ * Workflow-level authorization boundary.
+ *
+ * The API already performs this check, but the workflow must not depend on
+ * callers remembering to do so. This makes the workflow safe to reuse from
+ * other entry points (admin jobs, subscribers, bulk operations, etc.).
+ */
+export const validateVendorProductOwnershipStep = createStep(
+  "validate-vendor-product-ownership-step",
+  async (input: Input, { container }) => {
+    const query = container.resolve(ContainerRegistrationKeys.QUERY);
+
+    const { data: vendorAdmins } = await query.graph({
+      entity: "vendor_admin",
+      fields: ["id", "vendor.id"],
+      filters: { id: [input.vendor_admin_id] },
+    });
+
+    const vendorAdmin = vendorAdmins[0] as
+      | { id: string; vendor?: { id: string } }
+      | undefined;
+
+    if (!vendorAdmin?.vendor?.id) {
+      throw new Error("Unauthorized: vendor admin context is invalid.");
+    }
+
+    const vendorId = vendorAdmin.vendor.id;
+
+    const { data: links } = await query.graph({
+      entity: "vendor_product",
+      fields: ["vendor_id", "product_id"],
+      filters: {
+        vendor_id: [vendorId],
+        product_id: [input.product_id],
+      },
+    });
+
+    if (!links.length) {
+      throw new Error("Unauthorized: vendor does not own this product.");
+    }
+
+    const { data: products } = await query.graph({
+      entity: "product",
+      fields: ["id", "variants.id"],
+      filters: { id: [input.product_id] },
+    });
+
+    const product = products[0] as
+      | { id: string; variants?: { id: string }[] }
+      | undefined;
+
+    if (!product) {
+      throw new Error("Product not found.");
+    }
+
+    const productVariantIds = (product.variants ?? []).map((variant) => variant.id);
+    const requestedVariantIds = [...new Set(input.variant_ids ?? [])];
+    const productVariantIdSet = new Set(productVariantIds);
+
+    const invalidVariantIds = requestedVariantIds.filter(
+      (variantId) => !productVariantIdSet.has(variantId)
+    );
+
+    if (invalidVariantIds.length) {
+      throw new Error(
+        `Unauthorized: variant(s) do not belong to product ${input.product_id}: ${invalidVariantIds.join(", ")}`
+      );
+    }
+
+    return new StepResponse<Output>({
+      vendor_id: vendorId,
+      product_id: input.product_id,
+      product_variant_ids: productVariantIds,
+    });
+  }
+);
+
+export default validateVendorProductOwnershipStep;
