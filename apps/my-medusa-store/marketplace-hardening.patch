+async function queryExistingVendorOrderLinks(
+  container: any,
+  orderId: string,
+  vendorIds: string[]
+): Promise<Set<string>> {
+  const pg = container.resolve(ContainerRegistrationKeys.PG_CONNECTION);
+
+  const rows = await pg("marketplace_vendor_order_order")
+    .select("vendor_id", "order_id")
+    .where({ order_id: orderId })
+    .whereIn("vendor_id", vendorIds)
+    .whereNull("deleted_at");
+
+  return new Set(
+    rows.map((row: any) => `${row.vendor_id}:${row.order_id}`)
+  );
