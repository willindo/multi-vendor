+import { Modules } from "@medusajs/framework/utils";
+
+/**
+ * Canonical vendor-product projection used by list/detail/update responses.
+ * It converts Medusa's raw product graph into the inventory/price shape the
+ * vendor dashboard already consumes.
+ */
+export async function hydrateVendorProducts(scope: any, products: any[]) {
+  if (!products?.length) return [];
+
+  const inventoryService = scope.resolve(Modules.INVENTORY);
+  const inventoryItemIds = [
+    ...new Set(
+      products.flatMap((product) =>
+        (product.variants ?? []).flatMap((variant: any) =>
+          (variant.inventory_items ?? [])
+            .map((item: any) => item.inventory_item_id)
+            .filter(Boolean)
+        )
+      )
+    ),
+  ] as string[];
+
+  const locationId = process.env.MEDUSA_STOCK_LOCATION_ID;
+  const inventoryLevels = inventoryItemIds.length
+    ? await inventoryService.listInventoryLevels({
+        inventory_item_id: inventoryItemIds,
+        ...(locationId ? { location_id: [locationId] } : {}),
+      })
+    : [];
+
+  const inventoryMap = new Map<string, number>();
+  for (const level of inventoryLevels as any[]) {
+    const current = inventoryMap.get(level.inventory_item_id) ?? 0;
+    inventoryMap.set(
+      level.inventory_item_id,
+      current + Number(level.stocked_quantity ?? 0)
+    );
+  }
+
+  return products.map((product: any) => {
+    const variants = (product.variants ?? []).map((variant: any) => {
+      const prices = variant.price_set?.prices ?? [];
+      const primaryPrice = prices[0] ?? null;
+      const inventoryItems = (variant.inventory_items ?? []).map((item: any) => ({
+        ...item,
+        stocked_quantity: inventoryMap.get(item.inventory_item_id) ?? 0,
+      }));
+
+      const inventoryQuantity = inventoryItems.reduce(
+        (sum: number, item: any) =>
+          sum + Number(item.stocked_quantity ?? 0),
+        0
+      );
+
+      return {
+        ...variant,
+        price_amount: primaryPrice?.amount ?? 0,
+        currency_code: primaryPrice?.currency_code ?? null,
+        price_id: primaryPrice?.id ?? null,
+        prices,
+        inventory_quantity: inventoryQuantity,
+        stocked_quantity: inventoryQuantity,
+        inventory_items: inventoryItems,
+      };
+    });
+
+    return {
+      ...product,
+      variants,
+      inventory_quantity: variants.reduce(
+        (sum: number, variant: any) =>
+          sum + Number(variant.inventory_quantity ?? 0),
+        0
+      ),
+    };
+  });
+}
+
+export async function hydrateVendorProduct(scope: any, product: any) {
+  const [hydrated] = await hydrateVendorProducts(scope, product ? [product] : []);
+  return hydrated ?? null;
+}
